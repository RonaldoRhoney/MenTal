<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mesma splash nativa do Android 12+ (ver values-v31/styles.xml),
         só que com o tema escuro (Theme.Black) e a cor escura de
         AppColors.bg — ativa quando o SO está em modo escuro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
