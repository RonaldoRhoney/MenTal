<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- V2 item 9 — Contador de passos (STEP_COUNTER_MOVIMENTO.md §6).
         Exigida em runtime pelo Android 10+ (API 29+) para acessar o
         sensor TYPE_STEP_COUNTER; pedida de forma contextual quando o
         usuário abre a tela de Movimento pela primeira vez, nunca no
         onboarding genérico. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- V2 item 8 — Notificações (NOTIFICATIONS.md). Exigida em runtime
         pelo Android 13+ (API 33+) para exibir notificações — o próprio
         FirebaseMessaging.requestPermission() já cuida de pedir essa
         permissão em runtime, mas ela precisa estar declarada aqui. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foto de perfil (29/08/2026, pedido de Rhoney): "o usuário deve
         ter a opção de também tirar uma foto" — câmera como fonte
         alternativa à galeria (image_picker já cobria galeria; tirar
         foto exige esta permissão declarada, pedida em runtime pelo
         próprio image_picker na primeira vez que a câmera é usada). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:label="MENTAL"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Login real via Supabase Auth (Google/Facebook, OAuth via
                 navegador — FAMILY_SAFETY.md §3.1). Depois do login no
                 navegador, o Supabase redireciona de volta pro app por
                 este deep link — precisa bater exatamente com o valor
                 passado em signInWithOAuth() (login_screen.dart) e estar
                 cadastrado em Supabase Dashboard → Authentication → URL
                 Configuration → Redirect URLs. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.rhoneyinc.mental" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
