<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Achado de auditoria de segurança M5 (05/09/2026): INTERNET só
         estava declarada em src/debug/ e src/profile/ (herdada por
         acidente do merge de alguma dependência de debug), nunca aqui
         em main/ — o app depende 100% de rede (backend, Supabase Auth,
         Firebase). Declarar explicitamente em vez de depender de merge
         implícito de biblioteca de terceiro. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- V2 item 9 — Contador de passos (STEP_COUNTER_MOVIMENTO.md §6).
         Exigida em runtime pelo Android 10+ (API 29+) para acessar o
         sensor TYPE_STEP_COUNTER; pedida de forma contextual quando o
         usuário abre a tela de Movimento pela primeira vez, nunca no
         onboarding genérico. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Achado testando no celular real (02/09/2026): sem esta permissão
         (normal, concedida automaticamente na instalação — não pede
         diálogo em runtime), o Android 12+ (API 31+) bloqueia o registro
         do sensor TYPE_STEP_COUNTER com "Permission failure:
         HIGH_SAMPLING_RATE_SENSORS", mesmo com ACTIVITY_RECOGNITION já
         concedida — a tela de Movimento mostrava "Não foi possível ler o
         sensor de passos agora" permanentemente, mesmo após conceder a
         permissão certa. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- V2 item 8 — Notificações (NOTIFICATIONS.md). Exigida em runtime
         pelo Android 13+ (API 33+) para exibir notificações — o próprio
         FirebaseMessaging.requestPermission() já cuida de pedir essa
         permissão em runtime, mas ela precisa estar declarada aqui. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foto de perfil (29/08/2026, pedido de Rhoney): "o usuário deve
         ter a opção de também tirar uma foto" — câmera como fonte
         alternativa à galeria (image_picker já cobria galeria; tirar
         foto exige esta permissão declarada, pedida em runtime pelo
         próprio image_picker na primeira vez que a câmera é usada). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- V3.0.1 — foreground service (flutter_foreground_task) pra manter
         o listener do sensor de passos vivo com o app em segundo
         plano/tela apagada (achado real, 29/08/2026: sem isso, uma
         caminhada inteira com o celular no bolso não contabiliza nenhum
         passo — ver movement_service.dart e movement_task_handler.dart).
         foregroundServiceType "health" é a categoria correta do Android
         14+ pra contagem de passos/dados de saúde. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <application
        android:label="MENTAL"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- Achado de auditoria de segurança M5 (05/09/2026): sem
             allowBackup="false", o default é true — o token de sessão
             do Supabase guardado em SharedPreferences entraria no backup
             automático do Google Drive e em `adb backup`, risco de LGPD
             para um app com dado pessoal. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Login real via Supabase Auth (Google/Facebook, OAuth via
                 navegador — FAMILY_SAFETY.md §3.1). Depois do login no
                 navegador, o Supabase redireciona de volta pro app por
                 este deep link — precisa bater exatamente com o valor
                 passado em signInWithOAuth() (login_screen.dart) e estar
                 cadastrado em Supabase Dashboard → Authentication → URL
                 Configuration → Redirect URLs. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.rhoneyinc.mental" android:host="login-callback"/>
            </intent-filter>
        </activity>
        <!-- Warning: Do not change service name (flutter_foreground_task). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="health"
            android:exported="false" />
        <!-- NOTIFICACAO_ICONE_M_MENTAL.md — ícone monocromático (branco
             sobre transparente, gerado a partir de assets/icon/
             icon_foreground.png) usado como small icon em TODAS as
             notificações do app, de forma centralizada:
             1) meta-data abaixo, referenciado pelo NotificationIcon da
                notificação persistente de Movimento
                (movement_service.dart);
             2) default_notification_icon, usado pelo Firebase Messaging
                pra qualquer push (streak, ranking, Torcida etc.) que não
                especifique um ícone próprio — o backend (push.py) nunca
                define um, então esse default cobre todos eles de uma vez.
             Sem isso, o Android caía no ícone genérico do sistema
             (achado real, 03/09/2026). -->
        <meta-data
            android:name="com.rhoneyinc.mental.NOTIFICATION_ICON"
            android:resource="@drawable/ic_stat_mental" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_mental" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
